{
  "name": "autojev",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "node scripts/start.mjs",
    "python": "node scripts/python.mjs",
    "mcp": "node scripts/python.mjs -m autojav.selenium_server",
    "smoke": "node scripts/python.mjs scripts/smoke_test.py",
    "test": "node --test scripts/runtime.test.mjs && node scripts/python.mjs -m pytest -q",
    "lint": "node scripts/python.mjs -m ruff check backend"
  }
}
